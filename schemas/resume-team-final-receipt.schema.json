{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-team-final-receipt/v2",
  "title": "Native Resume Team final draft authorization receipt",
  "description": "A non-PII, independently checkable receipt for one authorized Markdown draft, the attested master-resume source, the exact job description, and the validated Researcher artifact. Verifiers must additionally require every nested draft digest to equal the verified target digest, the ordered vote IDs to equal the authorization-report vote IDs, authorization_digest to equal the canonical SHA-256 of authorization_report, and the source and job-description digests to match current trusted inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "draft_digest",
    "source_digest",
    "job_description_digest",
    "candidate_fit_report",
    "candidate_fit_report_digest",
    "candidate_fit_judge_report",
    "candidate_fit_judge_report_digest",
    "researcher_agent_id",
    "researcher_artifact_digest",
    "auditor_attestation",
    "authorization_digest",
    "authorization_report",
    "vote_invocation_ids",
    "publication_id",
    "verified_target_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "resume-team-final-receipt/v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "draft_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "job_description_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_fit_report": {
      "$ref": "#/$defs/candidateFitPassingReport"
    },
    "candidate_fit_report_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_fit_judge_report": {
      "description": "PROCEED judge verdict that authorized this run when the deterministic assessment did not pass; null when the deterministic assessment passed on its own.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidateFitJudgeProceedReport"
        }
      ]
    },
    "candidate_fit_judge_report_digest": {
      "description": "Canonical JSON digest of candidate_fit_judge_report; empty exactly when the report is null.",
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "researcher_agent_id": {
      "$ref": "#/$defs/nativeAgentId"
    },
    "researcher_artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "auditor_attestation": {
      "$ref": "#/$defs/auditorAttestation"
    },
    "authorization_digest": {
      "$ref": "#/$defs/digest"
    },
    "authorization_report": {
      "$ref": "#/$defs/authorizationReport"
    },
    "vote_invocation_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publication_id": {
      "type": "string",
      "minLength": 1
    },
    "verified_target_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nativeAgentId": {
      "type": "string",
      "description": "hosts: api = hosted product runtime; codex/claude = legacy local CLI hosts",
      "pattern": "^(codex|claude|api):[A-Za-z0-9._:-]{1,128}$"
    },
    "fitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "candidateFitComponentScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_have_evidence",
        "core_responsibilities",
        "preferred_qualifications",
        "evidence_quality",
        "role_similarity"
      ],
      "properties": {
        "must_have_evidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "core_responsibilities": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "preferred_qualifications": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "role_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "candidateFitKnockout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "requirement",
        "candidate_has"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "candidate_has": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidateFitReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "scorer_version",
        "run_id",
        "case_id",
        "as_of_date",
        "threshold",
        "analysis_mode",
        "resume_digest",
        "job_description_digest",
        "score",
        "component_scores",
        "recommendation",
        "hard_knockouts",
        "extraction_trustworthy",
        "passed",
        "codes",
        "eligibility",
        "unverified_requirements",
        "assessment_available",
        "evidence_bundle"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "policy_version": {
          "const": "candidate-fit-policy-v3"
        },
        "scorer_version": {
          "const": "evidence-match-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "as_of_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "threshold": {
          "type": "number",
          "minimum": 40,
          "maximum": 95
        },
        "resume_digest": {
          "$ref": "#/$defs/digest"
        },
        "job_description_digest": {
          "$ref": "#/$defs/digest"
        },
        "score": {
          "$ref": "#/$defs/fitScore"
        },
        "component_scores": {
          "$ref": "#/$defs/candidateFitComponentScores",
          "required": [
            "must_have_evidence",
            "core_responsibilities",
            "preferred_qualifications",
            "evidence_quality",
            "role_similarity"
          ],
          "properties": {
            "must_have_evidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "core_responsibilities": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "preferred_qualifications": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "evidence_quality": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "role_similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "recommendation": {
          "enum": [
            "PROCEED",
            "REJECT"
          ]
        },
        "hard_knockouts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidateFitKnockout"
          }
        },
        "extraction_trustworthy": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ASSESSMENT_UNAVAILABLE",
              "UNTRUSTWORTHY_EXTRACTION",
              "ELIGIBILITY_FAILED",
              "SCORE_BELOW_THRESHOLD"
            ]
          }
        },
        "analysis_mode": {
          "description": "How the assessment was produced. The gate is no longer offline; it runs the evidence engine against a hosted model.",
          "const": "evidence-engine"
        },
        "eligibility": {
          "description": "Hard-gate outcome. FAIL requires explicit contradictory evidence; a requirement the resume never mentions is UNVERIFIED and must not block tailoring.",
          "enum": [
            "PASS",
            "FAIL",
            "UNVERIFIED"
          ]
        },
        "unverified_requirements": {
          "description": "Non-blocking warnings: mandatory requirements the resume did not address. Absence of evidence is never a finding that the candidate lacks the qualification.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "reason"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assessment_available": {
          "description": "False when the evidence engine could not be reached. The gate fails closed, but ASSESSMENT_UNAVAILABLE is deliberately distinct from a fit rejection.",
          "type": "boolean"
        },
        "evidence_bundle": {
          "description": "Self-contained replayable evidence: the requirements, cited resume spans and judgments this report was derived from. Empty exactly when assessment_available is false. Validators replay this bundle \u2014 with no model call \u2014 and reject the report unless every reported number falls back out of it.",
          "type": "object"
        }
      }
    },
    "candidateFitPassingReport": {
      "allOf": [
        {
          "$ref": "#/$defs/candidateFitReport"
        },
        {
          "properties": {
            "recommendation": {
              "const": "PROCEED"
            },
            "hard_knockouts": {
              "maxItems": 0
            },
            "extraction_trustworthy": {
              "const": true
            },
            "passed": {
              "const": true
            },
            "codes": {
              "maxItems": 0
            },
            "score": {
              "minimum": 40
            }
          }
        }
      ],
      "description": "A deterministic assessment that itself passed the configured threshold (which the validator pins; 40 is the clamp floor)."
    },
    "auditorAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "artifact_digest",
        "verdict",
        "draft_digest"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/nativeAgentId"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "verdict": {
          "const": "PASS"
        },
        "draft_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "voteBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "name",
        "invocation_id",
        "passed",
        "draft_digest",
        "codes"
      ],
      "properties": {
        "schema_version": {
          "const": "resume-team-vote/v1"
        },
        "name": {
          "enum": [
            "evidence",
            "human_voice",
            "canonical_integrity"
          ]
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "const": true
        },
        "draft_digest": {
          "$ref": "#/$defs/digest"
        },
        "codes": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "evidenceVote": {
      "allOf": [
        {
          "$ref": "#/$defs/voteBase"
        },
        {
          "properties": {
            "name": {
              "const": "evidence"
            }
          }
        }
      ]
    },
    "humanVoiceVote": {
      "allOf": [
        {
          "$ref": "#/$defs/voteBase"
        },
        {
          "properties": {
            "name": {
              "const": "human_voice"
            }
          }
        }
      ]
    },
    "canonicalIntegrityVote": {
      "allOf": [
        {
          "$ref": "#/$defs/voteBase"
        },
        {
          "properties": {
            "name": {
              "const": "canonical_integrity"
            }
          }
        }
      ]
    },
    "authorizationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "draft_digest",
        "passed",
        "codes",
        "findings",
        "votes"
      ],
      "properties": {
        "schema_version": {
          "const": "resume-team-authorization/v1"
        },
        "draft_digest": {
          "$ref": "#/$defs/digest"
        },
        "passed": {
          "const": true
        },
        "codes": {
          "type": "array",
          "maxItems": 0
        },
        "findings": {
          "type": "array",
          "maxItems": 0
        },
        "votes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/evidenceVote"
            },
            {
              "$ref": "#/$defs/humanVoiceVote"
            },
            {
              "$ref": "#/$defs/canonicalIntegrityVote"
            }
          ],
          "items": false
        }
      }
    },
    "candidateFitJudgeReport": {
      "title": "Candidate-fit judge verdict",
      "description": "A reasoning-model verdict on whether tailoring may proceed. Untrusted until digest-bound to the exact run/resume/JD and until every requirement_quote is mechanically verified verbatim against the job description text; semantic enforcement is coordinator-owned (candidate_fit_judge.validate_candidate_fit_judge_report).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "prompt_version",
        "judge_model",
        "run_id",
        "case_id",
        "as_of_date",
        "resume_digest",
        "job_description_digest",
        "verdict",
        "fit_score",
        "hard_gaps",
        "rationale"
      ],
      "properties": {
        "schema_version": {
          "const": "candidate-fit-judge/v1"
        },
        "prompt_version": {
          "const": "fit-judge-prompt/v1"
        },
        "judge_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "as_of_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "resume_digest": {
          "$ref": "#/$defs/digest"
        },
        "job_description_digest": {
          "$ref": "#/$defs/digest"
        },
        "verdict": {
          "enum": [
            "PROCEED",
            "DECLINE"
          ]
        },
        "fit_score": {
          "$ref": "#/$defs/fitScore"
        },
        "hard_gaps": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_quote",
              "candidate_has"
            ],
            "properties": {
              "requirement_quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "candidate_has": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "candidateFitJudgeProceedReport": {
      "description": "A judge verdict that authorizes proceeding past a non-passing deterministic assessment.",
      "allOf": [
        {
          "$ref": "#/$defs/candidateFitJudgeReport"
        },
        {
          "properties": {
            "verdict": {
              "const": "PROCEED"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "candidate_fit_judge_report": {
            "type": "null"
          }
        },
        "required": [
          "candidate_fit_judge_report"
        ]
      },
      "then": {
        "properties": {
          "candidate_fit_report": {
            "$ref": "#/$defs/candidateFitPassingReport"
          },
          "candidate_fit_judge_report_digest": {
            "const": ""
          }
        }
      },
      "else": {
        "properties": {
          "candidate_fit_report": {
            "$ref": "#/$defs/candidateFitReport"
          },
          "candidate_fit_judge_report": {
            "$ref": "#/$defs/candidateFitJudgeProceedReport"
          },
          "candidate_fit_judge_report_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  ]
}
