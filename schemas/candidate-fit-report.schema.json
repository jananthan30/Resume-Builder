{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-fit-report/v1",
  "title": "Candidate Fit Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "scorer_version",
    "run_id",
    "case_id",
    "as_of_date",
    "threshold",
    "analysis_mode",
    "resume_digest",
    "job_description_digest",
    "score",
    "component_scores",
    "recommendation",
    "hard_knockouts",
    "extraction_trustworthy",
    "passed",
    "codes",
    "eligibility",
    "unverified_requirements",
    "assessment_available",
    "evidence_bundle"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "policy_version": {
      "const": "candidate-fit-policy-v3"
    },
    "scorer_version": {
      "const": "evidence-match-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "threshold": {
      "type": "number",
      "minimum": 40,
      "maximum": 95,
      "description": "The score bar this report was decided under. Validated as a shape, not pinned to a value: the policy number belongs in code, and hardcoding it here made the bar impossible to calibrate without a wire-contract change."
    },
    "resume_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "job_description_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "component_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_have_evidence",
        "core_responsibilities",
        "preferred_qualifications",
        "evidence_quality",
        "role_similarity"
      ],
      "properties": {
        "must_have_evidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "core_responsibilities": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "preferred_qualifications": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "role_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "recommendation": {
      "enum": [
        "PROCEED",
        "REJECT"
      ]
    },
    "hard_knockouts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "category",
          "requirement",
          "candidate_has"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "candidate_has": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraction_trustworthy": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    },
    "codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ASSESSMENT_UNAVAILABLE",
          "UNTRUSTWORTHY_EXTRACTION",
          "ELIGIBILITY_FAILED",
          "SCORE_BELOW_THRESHOLD"
        ]
      }
    },
    "analysis_mode": {
      "description": "How the assessment was produced. The gate is no longer offline; it runs the evidence engine against a hosted model.",
      "const": "evidence-engine"
    },
    "eligibility": {
      "description": "Hard-gate outcome. FAIL requires explicit contradictory evidence; a requirement the resume never mentions is UNVERIFIED and must not block tailoring.",
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    },
    "unverified_requirements": {
      "description": "Non-blocking warnings: mandatory requirements the resume did not address. Absence of evidence is never a finding that the candidate lacks the qualification.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "reason"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assessment_available": {
      "description": "False when the evidence engine could not be reached. The gate fails closed, but ASSESSMENT_UNAVAILABLE is deliberately distinct from a fit rejection.",
      "type": "boolean"
    },
    "evidence_bundle": {
      "description": "Self-contained replayable evidence: the requirements, cited resume spans and judgments this report was derived from. Empty exactly when assessment_available is false. Validators replay this bundle \u2014 with no model call \u2014 and reject the report unless every reported number falls back out of it.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "recommendation": {
            "const": "PROCEED"
          },
          "extraction_trustworthy": {
            "const": true
          },
          "score": {
            "minimum": 70.0
          },
          "hard_knockouts": {
            "maxItems": 0
          },
          "codes": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "recommendation": {
            "const": "REJECT"
          }
        }
      }
    }
  ]
}
