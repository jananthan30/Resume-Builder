# .dockerignore for the resume-scorer (ResumeHQ backend) deployment image.
# Build context is the repo root (`docker build -t ... .`); this trims it
# down to what scorer_server.py's runtime actually needs. Read the notes at
# the bottom before adding an entry here — a couple of gitignored/plugin-
# looking directories are deliberately NOT excluded.

# Version control / CI
.git
.github

# Claude Code / Codex plugin & agent scaffolding — local-CLI authoring
# assets, never imported by the FastAPI service
.claude/
.claude-plugin/
.codex/
.codex-plugin/
.agents/
.mcp.json
.codex.mcp.json
.frontier/
.resume-team-state/
.superpowers/

# Test suites, dev-only benchmarking, business/planning docs — not runtime
# code
tests/
benchmarks/
docs/

# Generated application output + tracker (personal resume/cover-letter data;
# never appropriate in a multi-tenant SaaS image)
applications/
Job_Application_Tracker.xlsx
Job_Application_Tracker.xlsx.bak
*.xlsx
config.json
Paramsothy_Resume_master.*
SUPPLEMENTAL_EXPERIENCE.md
FAERS_GLP1_PV_Project_Skeleton.txt

# Databases — local dev copies only; the real one lives on the Fly /data
# volume, not in the image
*.db

# Env files — secrets come from `fly secrets`, never baked into the image
.env*

# Caches / build artifacts / OS cruft
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
embed_cache/
node_modules/
.DS_Store

# -----------------------------------------------------------------------
# NOTE — do NOT add these, even though the pattern above might tempt it:
#
# cloud/  is gitignored from the PUBLIC repo (.gitignore) because it is the
#         private billing/auth/db/quotas layer, but scorer_server.py and
#         agent/tools.py import it directly at runtime
#         (`from cloud.auth import ...`, `from cloud.billing import ...`,
#         `from cloud.db import ...`, `from cloud.quotas import ...`,
#         `from cloud.config import settings`). Excluding it would build an
#         image that fails on the first request. It MUST ship in the image.
#
# skills/ looks like local-only Claude Code content, but skills/resume-team/
#         SKILL.md is plausibly the data a concurrently-developed feature
#         (agent/skills_loader.py + skills_server/) loads at runtime. Left
#         in rather than guessed away — verify with whoever owns that work
#         before excluding it.
